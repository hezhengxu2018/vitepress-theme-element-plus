{
  "$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "requireBranch": "main",
    "tagName": "v${version}",
    "push": true
  },
  "github": {
    "release": true
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it-plugins/workspaces": {
      "workspaces": [
        "packages/theme",
        "packages/docs"
      ],
      "publish": false,
      "skipChecks": true
    },
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "header": "# 更新日志\n\n",
      "ignoreRecommendedBump": true,
      "strictSemVer": true,
      "releaseCount": 0
    }
  },
  "hooks": {
    "before:init": ["pnpm -C packages/theme lint"],
    "after:release": "echo 发布完成！"
  }
}
